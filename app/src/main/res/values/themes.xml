<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EpubReader" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/reader_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- WebDAV 配置页：浅色主题（用户要求浅色，保证输入可见） -->
    <style name="Theme.EpubReader.WebDav" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/webdav_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
